# Copy to .env.local and adjust.

# Backend API base URL. Locally, the dev server proxies /api to the backend (see
# BACKEND_PROXY_TARGET), so the browser keeps the login cookies in every browser, Safari included
NEXT_PUBLIC_BACKEND_HOST=http://localhost:3000/api

# Dev only: where the dev server proxies /api (the backend's `make dev` serves it at
# http://api.localhost). Leave unset in production, where the frontend calls the API directly
BACKEND_PROXY_TARGET=http://api.localhost

# Contact email shown in the Help and About pages
NEXT_PUBLIC_CONTACT=
